--// DASH
local function DoDash()
	if not DashEnabled or not DashReady then return end
	local char = LocalPlayer.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then return end

	DashReady = false
	local look = root.CFrame.LookVector
	local direction = Vector3.new(look.X, 0, look.Z)
	if direction.Magnitude <= 0 then DashReady = true return end
	direction = direction.Unit

	humanoid:ChangeState(Enum.HumanoidStateType.Jumping)

	local dashVelocity = Instance.new("BodyVelocity")
	dashVelocity.Name = "DashVelocity"
	dashVelocity.MaxForce = Vector3.new(1000000, 1000000, 1000000)
	dashVelocity.P = 100000
	dashVelocity.Velocity = Vector3.new(direction.X * DashPowerValue, 22, direction.Z * DashPowerValue)
	dashVelocity.Parent = root

	task.delay(0.22, function()
		if dashVelocity and dashVelocity.Parent then dashVelocity:Destroy() end
	end)

	local originalSize = dashButton.Size
	local dashTween1 = TweenService:Create(dashButton, TweenInfo.new(0.10, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = UDim2.new(0, 112, 0.56, 0),
		Size = UDim2.fromOffset(DASH_BUTTON_SIZE + 6, DASH_BUTTON_SIZE + 6)
	})
	local dashTween2 = TweenService:Create(dashButton, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = UDim2.new(0, 105, 0.56, 0),
		Size = originalSize
	})
	dashTween1:Play()
	dashTween1.Completed:Connect(function()
		if dashButton and dashButton.Parent then dashTween2:Play() end
	end)

	local cooldownOverlay = Instance.new("Frame")
	cooldownOverlay.Name = "CooldownOverlay"
	cooldownOverlay.Size = UDim2.fromScale(1, 1)
	cooldownOverlay.Position = UDim2.fromScale(0, 0)
	cooldownOverlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	cooldownOverlay.BackgroundTransparency = 0.35
	cooldownOverlay.BorderSizePixel = 0
	cooldownOverlay.ZIndex = 3005
	cooldownOverlay.Parent = dashButton
	Instance.new("UICorner", cooldownOverlay).CornerRadius = UDim.new(1, 0)

	task.spawn(function()
		local startTime = tick()
		while tick() - startTime < DashCooldown do
			if not dashButton.Parent then break end
			local remaining = DashCooldown - (tick() - startTime)
			dashCooldownText.Text = string.format("%.1f", math.max(remaining, 0))
			task.wait(0.05)
		end
		dashCooldownText.Text = ""
		if cooldownOverlay and cooldownOverlay.Parent then cooldownOverlay:Destroy() end
		DashReady = true
	end)
end

