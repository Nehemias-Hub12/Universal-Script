--// DASH SYSTEM
-- Al pulsar Dash:
-- 1. Hace un salto normal hacia arriba.
-- 2. Aplica el impulso hacia delante.
-- 3. Conserva la potencia horizontal del Dash.
-- 4. El salto evita que el suelo frene inmediatamente el desplazamiento.
local function DoDash()
	if not DashEnabled then
		return
	end

	if not DashReady then
		return
	end

	local char = LocalPlayer.Character

	if not char then
		return
	end

	local root = char:FindFirstChild("HumanoidRootPart")
	local humanoid = char:FindFirstChildOfClass("Humanoid")

	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end

	DashReady = false

	local look = root.CFrame.LookVector

	local direction = Vector3.new(
		look.X,
		0,
		look.Z
	)

	if direction.Magnitude <= 0 then
		DashReady = true
		return
	end

	direction = direction.Unit

	--// SALTO NORMAL + DASH
	-- Se conserva la potencia vertical normal del salto.
	-- El movimiento horizontal usa directamente DashPowerValue.
	humanoid.Jump = true

	local currentVelocity = root.AssemblyLinearVelocity

	root.AssemblyLinearVelocity = Vector3.new(
		direction.X * DashPowerValue,
		math.max(currentVelocity.Y, JumpPowerValue),
		direction.Z * DashPowerValue
	)

	--// ANIMACIÓN DEL ICONO
	local originalSize = dashIcon.Size
	local originalPosition = dashIcon.Position

	local dashTween1 = TweenService:Create(
		dashIcon,
		TweenInfo.new(
			0.10,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{
			Position = UDim2.new(0.5, 9, 0.5, 0),
			Size = UDim2.fromOffset(39, 39)
		}
	)

	local dashTween2 = TweenService:Create(
		dashIcon,
		TweenInfo.new(
			0.18,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{
			Position = originalPosition,
			Size = originalSize
		}
	)

	dashTween1:Play()

	dashTween1.Completed:Connect(function()
		if dashIcon and dashIcon.Parent then
			dashTween2:Play()
		end
	end)

	--// COOLDOWN
	task.spawn(function()
		local startTime = tick()

		-- Botón oscuro mientras está en cooldown.
		dashButton.BackgroundColor3 = Color3.fromRGB(18, 24, 34)

		while tick() - startTime < DashCooldown do
			if not dashButton.Parent then
				break
			end

			local remaining =
				DashCooldown - (tick() - startTime)

			dashCooldownText.Text =
				string.format(
					"%.1f",
					math.max(remaining, 0)
				)

			dashCooldownText.TextColor3 =
				Color3.fromRGB(170, 190, 210)

			task.wait(0.05)
		end

		dashCooldownText.Text = ""
		dashCooldownText.TextColor3 =
			Color3.fromRGB(255, 255, 255)

		--// VUELVE A SU ASPECTO NORMAL
		dashButton.BackgroundColor3 = Theme.Container

		DashReady = true
	end)
end

dashButton.MouseButton1Click:Connect(function()
	DoDash()
end)

