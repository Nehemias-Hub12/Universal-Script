local function drawLine(line, p1, p2, color)
	if not p1 or not p2 then
		line.Visible = false
		return
	end

	local dx = p2.X - p1.X
	local dy = p2.Y - p1.Y

	local length =
		math.sqrt(dx * dx + dy * dy)

	line.Size =
		UDim2.fromOffset(
			math.max(length, 1),
			2
		)

	line.Position =
		UDim2.fromOffset(
			(p1.X + p2.X) / 2,
			(p1.Y + p2.Y) / 2
		)

	line.Rotation =
		math.deg(math.atan2(dy, dx))

	line.BackgroundColor3 = color
	line.Visible = true
end

--// AIMBOT
local function GetClosestHeadInFOV()
	local center = Vector2.new(
		Camera.ViewportSize.X / 2,
		Camera.ViewportSize.Y / 2
	)

	local maxDist = FOVSize / 2

	if currentTarget and currentTarget.Parent then
		local hum =
			currentTarget.Parent:FindFirstChildOfClass("Humanoid")

		if hum and hum.Health > 0 then
			local pos, onScreen =
				Camera:WorldToViewportPoint(
					currentTarget.Position
				)

			if onScreen then
				local screenPos =
					Vector2.new(pos.X, pos.Y)

				local dist =
					(center - screenPos).Magnitude

				if dist < maxDist * 1.4 then
					return currentTarget
				end
			end
		end
	end

	local closest = nil
	local shortest = maxDist

	for _, player in pairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local head =
				player.Character:FindFirstChild("Head")

			local humanoid =
				player.Character:FindFirstChildOfClass("Humanoid")

			if head and humanoid and humanoid.Health > 0 then
				local pos, onScreen =
					Camera:WorldToViewportPoint(
						head.Position
					)

				if onScreen then
					local screenPos =
						Vector2.new(pos.X, pos.Y)

					local distance =
						(center - screenPos).Magnitude

					if distance < shortest then
						shortest = distance
						closest = head
					end
				end
			end
		end
	end

	currentTarget = closest

	return closest
end

--// FLY
local BodyVelocity, BodyGyro

local function UpdateFly()
	local char = LocalPlayer.Character

	if not char
		or not char:FindFirstChild("HumanoidRootPart") then
		return
	end

	local root = char.HumanoidRootPart
	local humanoid = char:FindFirstChildOfClass("Humanoid")

	if FlyEnabled then
		if not BodyVelocity then
			BodyVelocity = Instance.new("BodyVelocity")
			BodyVelocity.MaxForce =
				Vector3.new(9e9, 9e9, 9e9)
			BodyVelocity.Parent = root

			BodyGyro = Instance.new("BodyGyro")
			BodyGyro.MaxTorque =
				Vector3.new(9e9, 9e9, 9e9)
			BodyGyro.P = 9e4
			BodyGyro.Parent = root

			if humanoid then
				humanoid.PlatformStand = true
			end
		end

		local cam = Camera.CFrame
		local move =
			humanoid and humanoid.MoveDirection
			or Vector3.zero

		local dir =
			(cam.LookVector * -move.Z)
			+ (cam.RightVector * move.X)

		BodyVelocity.Velocity =
			dir.Magnitude > 0
			and dir.Unit * FlySpeedValue
			or Vector3.zero

		BodyGyro.CFrame = cam
	else
		if BodyVelocity then
			BodyVelocity:Destroy()
			BodyVelocity = nil
		end

		if BodyGyro then
			BodyGyro:Destroy()
			BodyGyro = nil
		end

		if humanoid then
			humanoid.PlatformStand = false
		end
	end
end

--// HITBOX REAL + VISIBLE
-- La Hitbox ahora es una caja/cuadrado, no una cabeza grande.
local function UpdateHitbox()
	for _, player in pairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local head =
				player.Character:FindFirstChild("Head")

			local humanoid =
				player.Character:FindFirstChildOfClass("Humanoid")

			if head and humanoid and humanoid.Health > 0 then
				if HitboxEnabled then
					if not HitboxParts[player] then
						local part = Instance.new("Part")

						part.Name =
							"Hitbox_" .. player.Name

						--// HITBOX CUADRADA
						part.Shape = Enum.PartType.Block

						part.Size =
							Vector3.new(
								HitboxSize,
								HitboxSize,
								HitboxSize
							)

						part.Transparency = HitboxTransparency
						part.Color =
							Color3.fromRGB(255, 50, 50)

						part.Material = Enum.Material.Neon
						part.CanCollide = false
						part.CanTouch = false
						part.CanQuery = true
						part.Anchored = false
						part.Massless = true
						part.CastShadow = false
						part.Parent = player.Character

						local weld = Instance.new("Weld")

						weld.Part0 = head
						weld.Part1 = part
						weld.C0 = CFrame.new()
						weld.Parent = part

						HitboxParts[player] = part
					else
						local part = HitboxParts[player]

						if part and part.Parent then
							part.Size =
								Vector3.new(
									HitboxSize,
									HitboxSize,
									HitboxSize
								)

							part.Transparency =
								HitboxTransparency
						end
					end

					--// HITBOX REAL
					if not OriginalSizes[player] then
						OriginalSizes[player] = head.Size
					end

					head.Size =
						Vector3.new(
							HitboxSize * 0.9,
							HitboxSize * 0.9,
							HitboxSize * 0.9
						)

					head.Transparency = 1
					head.CanCollide = false
					head.Massless = true
				else
					if HitboxParts[player] then
						HitboxParts[player]:Destroy()
						HitboxParts[player] = nil
					end

					if OriginalSizes[player] then
						head.Size =
							OriginalSizes[player]

						head.Transparency = 0
						head.CanCollide = true
						head.Massless = false

						OriginalSizes[player] = nil
					end
				end
			else
				if HitboxParts[player] then
					HitboxParts[player]:Destroy()
					HitboxParts[player] = nil
				end
			end
		end
	end
end

