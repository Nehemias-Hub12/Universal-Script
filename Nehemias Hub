--// FUNCIONES CONFIG
local function EnsureFolder()
	if isfolder and not isfolder("NehemiasHubConfigs") then
		makefolder("NehemiasHubConfigs")
	end
end

local function GetConfigPath(name)
	return "NehemiasHubConfigs/" .. name .. ".json"
end

local function SaveConfig(name)
	if not name or name == "" then return false end
	EnsureFolder()

	local data = {
		ESPEnabled = ESPEnabled,
		LineEnabled = LineEnabled,
		RainbowEnabled = RainbowEnabled,
		HealthEnabled = HealthEnabled,
		SkeletonEnabled = SkeletonEnabled,
		HitboxEnabled = HitboxEnabled,
		AimbotFOVEnabled = AimbotFOVEnabled,
		VisibleCheckEnabled = VisibleCheckEnabled,
		FlyEnabled = FlyEnabled,
		NoclipEnabled = NoclipEnabled,
		InfiniteJumpEnabled = InfiniteJumpEnabled,
		SpeedEnabled = SpeedEnabled,
		JumpEnabled = JumpEnabled,
		DashEnabled = DashEnabled,
		FPSPingEnabled = FPSPingEnabled,
		AimbotTargetMode = AimbotTargetMode,
		AimbotPlayerTarget = AimbotPlayerTarget,
		FOVSize = FOVSize,
		AimbotSmoothness = AimbotSmoothness,
		HitboxSize = HitboxSize,
		HitboxTransparency = HitboxTransparency,
		WalkSpeedValue = WalkSpeedValue,
		DashPowerValue = DashPowerValue,
		JumpPowerValue = JumpPowerValue,
		ESPColor = {R = ESPColor.R, G = ESPColor.G, B = ESPColor.B},
		ThemeName = CurrentThemeName
	}

	local success = pcall(function()
		writefile(GetConfigPath(name), HttpService:JSONEncode(data))
	end)
	return success
end

local function LoadConfig(name)
	if not name or name == "" then return false end

	local success, content = pcall(function()
		return readfile(GetConfigPath(name))
	end)
	if not success or not content then return false end

	local ok, data = pcall(function()
		return HttpService:JSONDecode(content)
	end)
	if not ok or type(data) ~= "table" then return false end

	ESPEnabled = data.ESPEnabled or false
	LineEnabled = data.LineEnabled or false
	RainbowEnabled = data.RainbowEnabled or false
	HealthEnabled = data.HealthEnabled or false
	SkeletonEnabled = data.SkeletonEnabled or false
	HitboxEnabled = data.HitboxEnabled or false
	AimbotFOVEnabled = data.AimbotFOVEnabled or false
	VisibleCheckEnabled = data.VisibleCheckEnabled or false
	FlyEnabled = data.FlyEnabled or false
	NoclipEnabled = data.NoclipEnabled or false
	InfiniteJumpEnabled = data.InfiniteJumpEnabled or false
	SpeedEnabled = data.SpeedEnabled or false
	JumpEnabled = data.JumpEnabled or false
	DashEnabled = data.DashEnabled or false
	FPSPingEnabled = data.FPSPingEnabled or false

	AimbotTargetMode = data.AimbotTargetMode or "Head"
	AimbotPlayerTarget = data.AimbotPlayerTarget

	FOVSize = data.FOVSize or 120
	AimbotSmoothness = data.AimbotSmoothness or 0.38
	HitboxSize = data.HitboxSize or 5
	HitboxTransparency = data.HitboxTransparency or 0.55
	WalkSpeedValue = data.WalkSpeedValue or 16
	DashPowerValue = data.DashPowerValue or 120
	JumpPowerValue = data.JumpPowerValue or 50

	if data.ESPColor then
		ESPColor = Color3.new(data.ESPColor.R, data.ESPColor.G, data.ESPColor.B)
	end

	-- PRIMERO aplicar el tema
	if data.ThemeName then
		for _, t in ipairs(GUIThemes) do
			if t.Name == data.ThemeName then
				CurrentThemeName = t.Name
				ApplyTheme(t)
				break
			end
		end
	end

	-- DESPUÉS actualizar toggles
	local toggleStates = {
		ESPEnabled, LineEnabled, RainbowEnabled, HealthEnabled, SkeletonEnabled,
		HitboxEnabled, AimbotFOVEnabled, VisibleCheckEnabled,
		FlyEnabled, NoclipEnabled, InfiniteJumpEnabled,
		SpeedEnabled, JumpEnabled, DashEnabled, FPSPingEnabled
	}

	for i, state in ipairs(toggleStates) do
		if activeToggles[i] then
			activeToggles[i].setOn(state)
		end
	end

	if targetValue then targetValue.Text = AimbotTargetMode end
	if playerValue then playerValue.Text = AimbotPlayerTarget or "Todos" end
	dashButton.Visible = DashEnabled

	local sliderValues = {
		FOVSize,
		math.floor(AimbotSmoothness * 100),
		HitboxSize,
		math.floor(HitboxTransparency * 100),
		WalkSpeedValue,
		DashPowerValue,
		JumpPowerValue
	}

	for i, val in ipairs(sliderValues) do
		local s = sliderFills[i]
		if s and s.Fill and s.ValueLabel then
			local min = s.Min or 0
			local max = s.Max or 100
			local pos = math.clamp((val - min) / (max - min), 0, 1)
			s.Fill.Size = UDim2.new(pos, 0, 1, 0)
			s.ValueLabel.Text = tostring(val)
		end
	end

	return true
end

local function DeleteConfig(name)
	if not name or name == "" then return false end
	local success = pcall(function()
		delfile(GetConfigPath(name))
	end)
	return success
end

local function RefreshConfigList()
	for _, child in pairs(configList:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end

	local files = {}
	pcall(function()
		if listfiles then
			files = listfiles("NehemiasHubConfigs") or {}
		end
