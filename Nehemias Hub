--// TEMA
local function ApplyTheme(newTheme)
	Theme = newTheme

	main.BackgroundColor3 = Theme.Main
	mainStroke.Color = Theme.Stroke
	header.BackgroundColor3 = Theme.Header
	featuresTab.BackgroundColor3 = Theme.Accent
	restoreBtn.BackgroundColor3 = Theme.Accent
	restoreStroke.Color = Theme.Stroke
	featuresContent.ScrollBarImageColor3 = Theme.Stroke
	settingsContent.ScrollBarImageColor3 = Theme.Stroke

	statsFrame.BackgroundColor3 = Theme.Container
	statsFrame.BackgroundTransparency = 0.05
	statsStroke.Color = Theme.Stroke
	separator.TextColor3 = Theme.TextAccent

	dashButton.BackgroundColor3 = Theme.Container
	dashStroke.Color = Theme.Stroke

	for _, label in pairs(sectionLabels) do
		if label and label.Parent then
			label.TextColor3 = Theme.TextAccent
		end
	end

	for _, container in pairs(toggleContainers) do
		if container and container.Parent then
			container.BackgroundColor3 = Theme.Container
		end
	end

	for _, icon in pairs(toggleIcons) do
		if icon and icon.Parent then
			icon.TextColor3 = Theme.TextAccent
		end
	end

	for _, data in pairs(sliderFills) do
