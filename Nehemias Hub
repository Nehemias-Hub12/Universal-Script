			and Color3.fromRGB(255, 0, 0)
			or Color3.fromRGB(0, 255, 0)

		pingText.Text =
			"PING: " .. ping .. " ms"

		pingText.TextColor3 =
			ping >= 250
			and Color3.fromRGB(255, 0, 0)
			or Color3.fromRGB(0, 255, 0)
	end

	statsFrame.Visible = FPSPingEnabled

	fovCircle.Size =
		UDim2.fromOffset(
			FOVSize,
			FOVSize
		)

	fovCircle.Visible = AimbotFOVEnabled

	Hue = (Hue + 1) % 360

	local baseColor =
		RainbowEnabled
		and Color3.fromHSV(Hue / 360, 1, 1)
		or ESPColor

	for plr, o in pairs(ESP) do
		local c = plr.Character

		local hrp =
			c and c:FindFirstChild("HumanoidRootPart")

		local hum =
			c and c:FindFirstChildOfClass("Humanoid")

		local head =
			c and c:FindFirstChild("Head")

		local myHRP =
			LocalPlayer.Character
			and LocalPlayer.Character:FindFirstChild(
				"HumanoidRootPart"
			)

		local inRange, dist = false, 0

		if myHRP and hrp then
			dist =
				(myHRP.Position - hrp.Position).Magnitude

			inRange =
				dist <= ESPRadius
		end

		if
			(ESPEnabled
			or LineEnabled
			or HealthEnabled
			or SkeletonEnabled)
			and hrp
			and hum
			and hum.Health > 0
			and inRange
		then
			local col = baseColor

			o.H.Adornee = c
			o.H.Enabled = ESPEnabled
			o.H.FillColor = col
			o.H.OutlineColor = col

			local headWorld =
				head
				and (
					head.Position
					+ Vector3.new(0, 0.25, 0)
				)
				or (
					hrp.Position
					+ Vector3.new(0, 3, 0)
				)

			local feetWorld =
				hrp.Position
				- Vector3.new(0, 3, 0)

			local headScreen, headOn =
				Camera:WorldToViewportPoint(
					headWorld
				)

			local feetScreen, feetOn =
				Camera:WorldToViewportPoint(
					feetWorld
				)

			if headOn or feetOn then
				if headOn and ESPEnabled then
					o.N.Text = plr.Name
					o.N.TextColor3 = col

					o.N.Position =
						UDim2.fromOffset(
							headScreen.X,
							headScreen.Y - 6
						)

					o.N.Visible = true
				else
					o.N.Visible = false
				end

				if LineEnabled and feetOn then
					local sx =
						Camera.ViewportSize.X / 2

					local sy =
						Camera.ViewportSize.Y

					local dx =
						feetScreen.X - sx

					local dy =
						feetScreen.Y - sy

					o.L.Size =
						UDim2.fromOffset(
							math.max(
								math.sqrt(
									dx * dx + dy * dy
								),
								1
							),
							2
						)

					o.L.Position =
						UDim2.fromOffset(
							(sx + feetScreen.X) / 2,
							(sy + feetScreen.Y) / 2
						)

					o.L.Rotation =
						math.deg(
							math.atan2(dy, dx)
						)

					o.L.BackgroundColor3 = col
					o.L.Visible = true
				else
					o.L.Visible = false
				end

				if HealthEnabled and headOn and feetOn then
					local hp =
						math.clamp(
							hum.Health / hum.MaxHealth,
							0,
							1
						)

					local barH = 65

					o.HB.Size =
						UDim2.fromOffset(
							7,
							barH * hp
						)

					o.HB.Position =
						UDim2.fromOffset(
							headScreen.X - 28,
							(
								headScreen.Y
								+ feetScreen.Y
							) / 2
							- barH / 2
							+ barH * (1 - hp)
						)

					o.HB.BackgroundColor3 =
						hp > 0.6
						and Color3.fromRGB(
							0,
							255,
							0
						)
						or hp > 0.3
						and Color3.fromRGB(
							255,
							140,
							0
						)
						or Color3.fromRGB(
							255,
							0,
							0
						)

					o.HB.Visible = true

					o.HT.Text =
						math.floor(hp * 100) .. "%"

					o.HT.Position =
						UDim2.fromOffset(
							headScreen.X - 24,
							(
								headScreen.Y
								+ feetScreen.Y
							) / 2
						)

					o.HT.Visible = true
				else
					o.HB.Visible = false
					o.HT.Visible = false
				end

				if feetOn then
					o.D.Text =
						math.floor(dist)
						.. " studs"

					o.D.TextColor3 = col

					o.D.Position =
						UDim2.fromOffset(
							feetScreen.X,
							feetScreen.Y + 3
						)

					o.D.Visible = true
				else
					o.D.Visible = false
				end

				if SkeletonEnabled then
					local function gp(n)
						local p = c:FindFirstChild(n)

						if p then
							local pos, on =
								Camera:WorldToViewportPoint(
									p.Position
								)

							if on then
								return Vector2.new(
									pos.X,
									pos.Y
								)
							end
						end
					end

					local connections = {
						{
							gp("Head"),
							gp("UpperTorso")
								or gp("Torso")
						},
						{
							gp("UpperTorso")
								or gp("Torso"),
							gp("LeftUpperArm")
								or gp("Left Arm")
						},
						{
							gp("LeftUpperArm")
								or gp("Left Arm"),
							gp("LeftLowerArm")
								or gp("Left Arm")
						},
						{
							gp("LeftLowerArm")
								or gp("Left Arm"),
							gp("LeftHand")
						},
						{
							gp("UpperTorso")
								or gp("Torso"),
							gp("RightUpperArm")
								or gp("Right Arm")
						},
						{
							gp("RightUpperArm")
								or gp("Right Arm"),
							gp("RightLowerArm")
								or gp("Right Arm")
						},
						{
							gp("RightLowerArm")
								or gp("Right Arm"),
							gp("RightHand")
						},
						{
							gp("UpperTorso")
								or gp("Torso"),
							gp("LowerTorso")
								or gp("Torso")
						},
						{
							gp("LowerTorso")
								or gp("Torso"),
							gp("LeftUpperLeg")
								or gp("Left Leg")
						},
						{
							gp("LeftUpperLeg")
								or gp("Left Leg"),
							gp("LeftLowerLeg")
								or gp("Left Leg")
						},
						{
							gp("LeftLowerLeg")
								or gp("Left Leg"),
							gp("LeftFoot")
						},
						{
							gp("LowerTorso")
								or gp("Torso"),
							gp("RightUpperLeg")
								or gp("Right Leg")
						},
						{
							gp("RightUpperLeg")
								or gp("Right Leg"),
							gp("RightLowerLeg")
								or gp("Right Leg")
						},
						{
							gp("RightLowerLeg")
								or gp("Right Leg"),
							gp("RightFoot")
						},
					}

					for i = 1, #o.S do
						local conn = connections[i]

						if
							conn
							and conn[1]
							and conn[2]
						then
							drawLine(
								o.S[i],
								conn[1],
								conn[2],
								col
							)
						else
							o.S[i].Visible = false
						end
					end
				else
					for _, l in pairs(o.S) do
						l.Visible = false
					end
				end
			else
				o.N.Visible = false
				o.L.Visible = false
				o.HB.Visible = false
				o.HT.Visible = false
				o.D.Visible = false

				for _, l in pairs(o.S) do
					l.Visible = false
				end
			end
		else
			o.H.Enabled = false
			o.N.Visible = false
			o.L.Visible = false
			o.HB.Visible = false
			o.HT.Visible = false
			o.D.Visible = false

			for _, l in pairs(o.S) do
				l.Visible = false
			end
		end
	end

	--// AIMBOT
	if AimbotFOVEnabled then
		local target = GetClosestHeadInFOV()

		if target then
			local cam = Camera.CFrame

			local sticky =
				math.clamp(
					AimbotSmoothness + 0.35,
					0.55,
					0.85
				)

			Camera.CFrame =
				cam:Lerp(
					CFrame.new(
						cam.Position,
						target.Position
					),
					sticky
				)
		else
			currentTarget = nil
		end
	else
		currentTarget = nil
	end

	UpdateFly()
	UpdateHitbox()

	if NoclipEnabled and LocalPlayer.Character then
		for _, p in pairs(
			LocalPlayer.Character:GetDescendants()
		) do
			if p:IsA("BasePart") then
				p.CanCollide = false
			end
		end
	end

	--// SPEED + JUMP
	if
		LocalPlayer.Character
		and LocalPlayer.Character:FindFirstChildOfClass(
			"Humanoid"
		)
	then
		local h =
			LocalPlayer.Character:FindFirstChildOfClass(
				"Humanoid"
			)

		if SpeedEnabled then
			h.WalkSpeed = WalkSpeedValue
		else
			h.WalkSpeed = 16
		end

		if JumpEnabled then
			h.JumpPower = JumpPowerValue
		else
			h.JumpPower = 50
		end
	end
end)

--// INFINITE JUMP
UserInputService.JumpRequest:Connect(function()
	if
		InfiniteJumpEnabled
		and LocalPlayer.Character
		and LocalPlayer.Character:FindFirstChildOfClass(
			"Humanoid"
		)
	then
		LocalPlayer.Character.Humanoid:ChangeState(
			Enum.HumanoidStateType.Jumping
		)
	end
end)

print(
	"Universal script v2.8 - Aimbot + ESP + Hitbox + Dash + Speed/Jump + Universal"
)
