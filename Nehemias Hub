	table.insert(activeToggles, toggleData)

	btn.MouseButton1Click:Connect(function()
		state = not state
		toggleData.setOn(state)
		callback(state)
	end)

	return y + 52
end

local function createSlider(parent, text, desc, y, min, max, default, callback)
	local frame = Instance.new("Frame", parent)
	frame.Size = UDim2.new(1, 0, 0, 50)
	frame.Position = UDim2.fromOffset(0, y)
	frame.BackgroundTransparency = 1

	local titleLbl = Instance.new("TextLabel", frame)
	titleLbl.Size = UDim2.new(0.7, 0, 0, 15)
	titleLbl.Position = UDim2.fromOffset(2, 1)
	titleLbl.BackgroundTransparency = 1
	titleLbl.Text = text
	titleLbl.Font = Enum.Font.GothamBold
	titleLbl.TextSize = 11
	titleLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
	titleLbl.TextXAlignment = Enum.TextXAlignment.Left

	local valueLabel = Instance.new("TextLabel", frame)
	valueLabel.Size = UDim2.new(0.3, -2, 0, 15)
	valueLabel.Position = UDim2.new(0.7, 0, 0, 1)
	valueLabel.BackgroundTransparency = 1
	valueLabel.Text = tostring(default)
	valueLabel.Font = Enum.Font.GothamBold
	valueLabel.TextSize = 11
	valueLabel.TextColor3 = Theme.TextAccent
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right

	local descLabel = Instance.new("TextLabel", frame)
	descLabel.Size = UDim2.new(1, 0, 0, 12)
	descLabel.Position = UDim2.fromOffset(2, 16)
	descLabel.BackgroundTransparency = 1
	descLabel.Text = desc
	descLabel.Font = Enum.Font.Gotham
	descLabel.TextSize = 9
	descLabel.TextColor3 = Color3.fromRGB(130, 160, 190)
	descLabel.TextXAlignment = Enum.TextXAlignment.Left

	local barBg = Instance.new("Frame", frame)
	barBg.Size = UDim2.new(1, -4, 0, 5)
	barBg.Position = UDim2.fromOffset(2, 35)
	barBg.BackgroundColor3 = Color3.fromRGB(30, 45, 65)
	Instance.new("UICorner", barBg).CornerRadius = UDim.new(1, 0)

	local barFill = Instance.new("Frame", barBg)
	barFill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
	barFill.BackgroundColor3 = Theme.Accent
	Instance.new("UICorner", barFill).CornerRadius = UDim.new(1, 0)

	table.insert(sliderFills, {
		Fill = barFill,
		ValueLabel = valueLabel,
		Min = min,
		Max = max
	})

	local dragging = false
	local button = Instance.new("TextButton", barBg)
	button.Size = UDim2.new(1, 0, 1, 0)
	button.BackgroundTransparency = 1
	button.Text = ""

	local function update(input)
		local pos = math.clamp((input.Position.X - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
		local value = math.floor(min + (max - min) * pos)
		barFill.Size = UDim2.new(pos, 0, 1, 0)
		valueLabel.Text = tostring(value)
		callback(value)
	end

	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			update(input)
		end
	end)

	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			update(input)
		end
	end)

	return y + 56
end

