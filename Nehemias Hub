local function ApplyTheme(newTheme)
	Theme = newTheme

	main.BackgroundColor3 = Theme.Main
	mainStroke.Color = Theme.Stroke
	header.BackgroundColor3 = Theme.Header
	featuresTab.BackgroundColor3 = Theme.Accent
	restoreBtn.BackgroundColor3 = Theme.Accent
	restoreStroke.Color = Theme.Stroke
	featuresContent.ScrollBarImageColor3 = Theme.Stroke
	settingsContent.ScrollBarImageColor3 = Theme.Stroke
	statsFrame.BackgroundColor3 = Theme.Container
	statsStroke.Color = Theme.Stroke
	separator.TextColor3 = Theme.TextAccent

	for _, label in pairs(sectionLabels) do
		if label and label.Parent then
			label.TextColor3 = Theme.TextAccent
		end
	end

	for _, container in pairs(toggleContainers) do
		if container and container.Parent then
			container.BackgroundColor3 = Theme.Container
		end
	end

	for _, icon in pairs(toggleIcons) do
		if icon and icon.Parent then
			icon.TextColor3 = Theme.TextAccent
		end
	end

	for _, data in pairs(sliderFills) do
		if data.Fill and data.Fill.Parent then
			data.Fill.BackgroundColor3 = Theme.Accent
		end
		if data.ValueLabel and data.ValueLabel.Parent then
			data.ValueLabel.TextColor3 = Theme.TextAccent
		end
	end

	fovStroke.Color = Theme.Stroke

	if targetContainer then targetContainer.BackgroundColor3 = Theme.Container end
	if targetTitle then targetTitle.TextColor3 = Color3.fromRGB(255, 255, 255) end
	if targetValue then targetValue.TextColor3 = Theme.TextAccent end
	if targetArrow then targetArrow.TextColor3 = Theme.TextAccent end

	if playerContainer then playerContainer.BackgroundColor3 = Theme.Container end
	if playerTitle then playerTitle.TextColor3 = Color3.fromRGB(255, 255, 255) end
	if playerValue then playerValue.TextColor3 = Theme.TextAccent end
	if playerArrow then playerArrow.TextColor3 = Theme.TextAccent end

	-- Actualizar color de los switches de los toggles
	for _, data in pairs(activeToggles) do
		if data and data.setOn and data.isOn then
			data.setOn(data.isOn())
		end
	end
end

