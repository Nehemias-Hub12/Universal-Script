local function drawLine(line, p1, p2, color)
	if not p1 or not p2 then line.Visible = false return end
	local dx = p2.X - p1.X
	local dy = p2.Y - p1.Y
	local length = math.sqrt(dx * dx + dy * dy)
	line.Size = UDim2.fromOffset(math.max(length, 1), 2)
	line.Position = UDim2.fromOffset((p1.X + p2.X) / 2, (p1.Y + p2.Y) / 2)
	line.Rotation = math.deg(math.atan2(dy, dx))
	line.BackgroundColor3 = color
	line.Visible = true
end

local function GetAimbotPart(character)
	if not character then return nil end
	if AimbotTargetMode == "Head" then
		return character:FindFirstChild("Head")
	elseif AimbotTargetMode == "Torso" then
		return character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart")
	elseif AimbotTargetMode == "Pies" then
		return character:FindFirstChild("LeftFoot") or character:FindFirstChild("LeftLowerLeg") or character:FindFirstChild("Left Leg") or character:FindFirstChild("HumanoidRootPart")
	end
	return character:FindFirstChild("Head")
end

local function IsTargetVisible(part)
	if not VisibleCheckEnabled then return true end
	if not part then return false end
	local character = part.Parent
	if not character then return false end
	local origin = Camera.CFrame.Position
	local direction = part.Position - origin
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
	params.IgnoreWater = true
	local result = workspace:Raycast(origin, direction, params)
	if not result then return true end
	return result.Instance:IsDescendantOf(character)
end

local function GetSelectedAimbotPlayer()
	if not AimbotPlayerTarget then return nil end
	local player = Players:FindFirstChild(AimbotPlayerTarget)
	if player and player ~= LocalPlayer and player.Character then
		local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health > 0 then return player end
	end
	return nil
end

local function GetClosestTargetInFOV()
	local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
	local maxDist = FOVSize / 2
	local selectedPlayer = GetSelectedAimbotPlayer()

	if selectedPlayer then
		local part = GetAimbotPart(selectedPlayer.Character)
		local humanoid = selectedPlayer.Character:FindFirstChildOfClass("Humanoid")
		if part and humanoid and humanoid.Health > 0 and IsTargetVisible(part) then
			local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
			if onScreen then
				local screenPos = Vector2.new(pos.X, pos.Y)
				local distance = (center - screenPos).Magnitude
				if distance <= maxDist then return part end
			end
		end
		return nil
	end

	local closest = nil
	local shortest = maxDist
	for _, player in pairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
			local part = GetAimbotPart(player.Character)
			if part and humanoid and humanoid.Health > 0 and IsTargetVisible(part) then
				local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
				if onScreen then
					local screenPos = Vector2.new(pos.X, pos.Y)
					local distance = (center - screenPos).Magnitude
					if distance < shortest then
						shortest = distance
						closest = part
					end
				end
			end
		end
	end
	return closest
end

--// FLY
local BodyVelocity, BodyGyro

local function UpdateFly()
	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local root = char.HumanoidRootPart
	local humanoid = char:FindFirstChildOfClass("Humanoid")

	if FlyEnabled then
		if not BodyVelocity then
			BodyVelocity = Instance.new("BodyVelocity")
			BodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
			BodyVelocity.Parent = root
			BodyGyro = Instance.new("BodyGyro")
			BodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
			BodyGyro.P = 9e4
			BodyGyro.Parent = root
			if humanoid then humanoid.PlatformStand = true end
		end
		local cam = Camera.CFrame
		local move = humanoid and humanoid.MoveDirection or Vector3.zero
		local dir = (cam.LookVector * -move.Z) + (cam.RightVector * move.X)
		BodyVelocity.Velocity = dir.Magnitude > 0 and dir.Unit * FlySpeedValue or Vector3.zero
		BodyGyro.CFrame = cam
	else
		if BodyVelocity then BodyVelocity:Destroy() BodyVelocity = nil end
		if BodyGyro then BodyGyro:Destroy() BodyGyro = nil end
		if humanoid then humanoid.PlatformStand = false end
	end
end

--// HITBOX
local function UpdateHitbox()
	for _, player in pairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local head = player.Character:FindFirstChild("Head")
			local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
			if head and humanoid and humanoid.Health > 0 then
				if HitboxEnabled then
					if not HitboxParts[player] then
						local part = Instance.new("Part")
						part.Name = "Hitbox_" .. player.Name
						part.Shape = Enum.PartType.Block
						part.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
						part.Transparency = HitboxTransparency
						part.Color = Color3.fromRGB(255, 50, 50)
						part.Material = Enum.Material.Neon
						part.CanCollide = false
						part.Anchored = false
						part.Massless = true
						part.CastShadow = false
						part.Parent = player.Character
						local weld = Instance.new("Weld")
						weld.Part0 = head
						weld.Part1 = part
						weld.C0 = CFrame.new()
						weld.Parent = part
						HitboxParts[player] = part
					else
						local part = HitboxParts[player]
						if part and part.Parent then
							part.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
							part.Transparency = HitboxTransparency
						end
					end
					if not OriginalSizes[player] then OriginalSizes[player] = head.Size end
					head.Size = Vector3.new(HitboxSize * 0.9, HitboxSize * 0.9, HitboxSize * 0.9)
					head.Transparency = HitboxTransparency
					head.CanCollide = false
					head.Massless = true
				else
					if HitboxParts[player] then
						HitboxParts[player]:Destroy()
						HitboxParts[player] = nil
					end
					if OriginalSizes[player] then
						head.Size = OriginalSizes[player]
						head.Transparency = 0
						head.CanCollide = true
						head.Massless = false
						OriginalSizes[player] = nil
					end
				end
			end
		end
	end
end

--// LOOP
local lastStatsUpdate = 0
local frames = 0
local currentFPS = 0

RunService.RenderStepped:Connect(function()
	frames += 1
	local now = tick()

	if now - lastStatsUpdate >= 1 then
		currentFPS = frames
		frames = 0
		lastStatsUpdate = now
		local ping = 0
		pcall(function()
			ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
		end)
		fpsText.Text = "FPS: " .. currentFPS
		fpsText.TextColor3 = currentFPS < 30 and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 255, 0)
		pingText.Text = "PING: " .. ping .. " ms"
		pingText.TextColor3 = ping >= 250 and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 255, 0)
	end

	statsFrame.Visible = FPSPingEnabled
	fovCircle.Size = UDim2.fromOffset(FOVSize, FOVSize)
	fovCircle.Visible = AimbotFOVEnabled

	Hue = (Hue + 1) % 360
	local baseColor = RainbowEnabled and Color3.fromHSV(Hue / 360, 1, 1) or ESPColor

	for plr, o in pairs(ESP) do
		local c = plr.Character
		local hrp = c and c:FindFirstChild("HumanoidRootPart")
		local hum = c and c:FindFirstChildOfClass("Humanoid")
		local head = c and c:FindFirstChild("Head")
		local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		local inRange, dist = false, 0

		if myHRP and hrp then
			dist = (myHRP.Position - hrp.Position).Magnitude
			inRange = dist <= ESPRadius
		end

		if (ESPEnabled or LineEnabled or HealthEnabled or SkeletonEnabled) and hrp and hum and hum.Health > 0 and inRange then
			local col = baseColor
			o.H.Adornee = c
			o.H.Enabled = ESPEnabled
			o.H.FillColor = col
			o.H.OutlineColor = col

			local headWorld = head and (head.Position + Vector3.new(0, 0.25, 0)) or (hrp.Position + Vector3.new(0, 3, 0))
			local feetWorld = hrp.Position - Vector3.new(0, 3, 0)
			local headScreen, headOn = Camera:WorldToViewportPoint(headWorld)
			local feetScreen, feetOn = Camera:WorldToViewportPoint(feetWorld)

			if headOn or feetOn then
				if headOn and ESPEnabled then
					o.N.Text = plr.Name
					o.N.TextColor3 = col
					o.N.Position = UDim2.fromOffset(headScreen.X, headScreen.Y - 6)
					o.N.Visible = true
				else
					o.N.Visible = false
				end

				if LineEnabled and feetOn then
					local sx = Camera.ViewportSize.X / 2
					local sy = Camera.ViewportSize.Y
					local dx = feetScreen.X - sx
					local dy = feetScreen.Y - sy
					o.L.Size = UDim2.fromOffset(math.max(math.sqrt(dx * dx + dy * dy), 1), 2)
					o.L.Position = UDim2.fromOffset((sx + feetScreen.X) / 2, (sy + feetScreen.Y) / 2)
					o.L.Rotation = math.deg(math.atan2(dy, dx))
					o.L.BackgroundColor3 = col
					o.L.Visible = true
				else
					o.L.Visible = false
				end

				if HealthEnabled and headOn and feetOn then
					local hp = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
					local barH = 65
					o.HB.Size = UDim2.fromOffset(7, barH * hp)
					o.HB.Position = UDim2.fromOffset(headScreen.X - 28, (headScreen.Y + feetScreen.Y) / 2 - barH / 2 + barH * (1 - hp))
					o.HB.BackgroundColor3 = hp > 0.6 and Color3.fromRGB(0, 255, 0) or hp > 0.3 and Color3.fromRGB(255, 140, 0) or Color3.fromRGB(255, 0, 0)
					o.HB.Visible = true
					o.HT.Text = math.floor(hp * 100) .. "%"
					o.HT.Position = UDim2.fromOffset(headScreen.X - 24, (headScreen.Y + feetScreen.Y) / 2)
					o.HT.Visible = true
				else
					o.HB.Visible = false
					o.HT.Visible = false
				end

				if feetOn then
					o.D.Text = math.floor(dist) .. " studs"
					o.D.TextColor3 = col
					o.D.Position = UDim2.fromOffset(feetScreen.X, feetScreen.Y + 3)
					o.D.Visible = true
				else
					o.D.Visible = false
				end

				if SkeletonEnabled then
					local function gp(n)
						local p = c:FindFirstChild(n)
						if p then
							local pos, on = Camera:WorldToViewportPoint(p.Position)
							if on then return Vector2.new(pos.X, pos.Y) end
						end
					end
					local connections = {
						{gp("Head"), gp("UpperTorso") or gp("Torso")},
						{gp("UpperTorso") or gp("Torso"), gp("LeftUpperArm") or gp("Left Arm")},
						{gp("LeftUpperArm") or gp("Left Arm"), gp("LeftLowerArm") or gp("Left Arm")},
						{gp("LeftLowerArm") or gp("Left Arm"), gp("LeftHand")},
						{gp("UpperTorso") or gp("Torso"), gp("RightUpperArm") or gp("Right Arm")},
						{gp("RightUpperArm") or gp("Right Arm"), gp("RightLowerArm") or gp("Right Arm")},
						{gp("RightLowerArm") or gp("Right Arm"), gp("RightHand")},
						{gp("UpperTorso") or gp("Torso"), gp("LowerTorso") or gp("Torso")},
						{gp("LowerTorso") or gp("Torso"), gp("LeftUpperLeg") or gp("Left Leg")},
						{gp("LeftUpperLeg") or gp("Left Leg"), gp("LeftLowerLeg") or gp("Left Leg")},
						{gp("LeftLowerLeg") or gp("Left Leg"), gp("LeftFoot")},
						{gp("LowerTorso") or gp("Torso"), gp("RightUpperLeg") or gp("Right Leg")},
						{gp("RightUpperLeg") or gp("Right Leg"), gp("RightLowerLeg") or gp("Right Leg")},
						{gp("RightLowerLeg") or gp("Right Leg"), gp("RightFoot")},
					}
					for i = 1, #o.S do
						local conn = connections[i]
						if conn and conn[1] and conn[2] then
							drawLine(o.S[i], conn[1], conn[2], col)
						else
							o.S[i].Visible = false
						end
					end
				else
					for _, l in pairs(o.S) do l.Visible = false end
				end
			else
				o.N.Visible = false
				o.L.Visible = false
				o.HB.Visible = false
				o.HT.Visible = false
				o.D.Visible = false
				for _, l in pairs(o.S) do l.Visible = false end
			end
		else
			o.H.Enabled = false
			o.N.Visible = false
			o.L.Visible = false
			o.HB.Visible = false
			o.HT.Visible = false
			o.D.Visible = false
			for _, l in pairs(o.S) do l.Visible = false end
		end
	end

	if AimbotFOVEnabled then
		local target = GetClosestTargetInFOV()
		if target then
			currentTarget = target
			local cam = Camera.CFrame
			local sticky = math.clamp(AimbotSmoothness + 0.35, 0.55, 0.85)
			Camera.CFrame = cam:Lerp(CFrame.new(cam.Position, target.Position), sticky)
		else
			currentTarget = nil
		end
	else
		currentTarget = nil
	end

	UpdateFly()
	UpdateHitbox()

	if NoclipEnabled and LocalPlayer.Character then
		for _, p in pairs(LocalPlayer.Character:GetDescendants()) do
			if p:IsA("BasePart") then p.CanCollide = false end
		end
	end

	if LocalPlayer.Character then
		local h = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		if h then
			if SpeedEnabled then h.WalkSpeed = WalkSpeedValue end
			if JumpEnabled then h.JumpPower = JumpPowerValue end
		end
	end
end)

